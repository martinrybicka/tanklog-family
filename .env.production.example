# Pouze šablona. Nic nenasazuje; doplňte až po zjištění serveru a samostatném povolení.
TANKLOG_ENV=production
TANKLOG_PUBLIC_ORIGIN=https://tanklog.example.invalid
DJANGO_ALLOWED_HOSTS=tanklog.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://tanklog.example.invalid
DJANGO_DEBUG=false
DJANGO_SECURE_COOKIES=true
DJANGO_SECRET_KEY=
POSTGRES_DB=tanklog
POSTGRES_USER=tanklog
POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=tanklog_bootstrap
POSTGRES_ADMIN_PASSWORD=
NPM_NETWORK_NAME=
# Preferujte přesnou stabilní IP důvěryhodného NPM /32 nebo /128.
NPM_TRUSTED_CIDR=
# Zapnout až po ověření domény a HTTPS; ponecháno ADR-027.
DJANGO_HSTS_SECONDS=0
TANKLOG_REVISION=
# Předem připojené šifrované/off-host úložiště. Nikdy fallback na místní prázdný adresář.
BACKUP_DIRECTORY=
BACKUP_RECIPIENT_FILE=
BACKUP_TMPFS_SIZE=1073741824
BACKUP_MAX_RESTORE_BYTES=536870912
TANKLOG_OPERATIONS_OWNER=
