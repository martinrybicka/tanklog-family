geo $realip_remote_addr $tanklog_trusted_proxy {
    default 0;
    ${NPM_TRUSTED_CIDR} 1;
}
map "$tanklog_trusted_proxy:$http_x_forwarded_proto" $tanklog_proto {
    default http;
    "1:https" https;
}
server {
    listen 8080;
    server_name _;
    set_real_ip_from ${NPM_TRUSTED_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    client_max_body_size 1m;
    root /usr/share/nginx/html;
    include /etc/nginx/tanklog/security-headers.conf;
    include /etc/nginx/tanklog/proxy-api.conf;
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        include /etc/nginx/tanklog/security-headers.conf;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
        include /etc/nginx/tanklog/security-headers.conf;
        add_header Cache-Control "no-cache";
    }
}
