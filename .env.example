# Vygenerujte lokální tajné hodnoty: python3 infra/setup_env.py
TANKLOG_ENV=development
DJANGO_SECRET_KEY=
POSTGRES_DB=tanklog
POSTGRES_USER=tanklog
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
TANKLOG_PUBLIC_ORIGIN=http://localhost:8080
# Produkční prostředí má samostatnou šablonu .env.production.example a postup docs/OPERATIONS.md.
NPM_NETWORK_NAME=npm_proxy
NPM_TRUSTED_CIDR=
DJANGO_HSTS_SECONDS=0
